# Copy this file to .env for local Docker Compose use.
# NEVER commit a real .env file. .env is already covered by .gitignore's
# generic *.local / env patterns -- double check it's ignored before committing.

# --- Local PostgreSQL (used by docker-compose.yaml) ---
DB_NAME=ecommerce_db
DB_USERNAME=ecommerce_user
DB_PASSWORD=change_me_locally

# --- Backend ---
# Generate a real secret locally, e.g.: openssl rand -base64 48
JWT_SECRET=replace_with_a_generated_base64_secret
PORT=8080

# --- Production (Render + Neon) ---
# These are set as Render environment variables, not in this file:
# DB_URL=jdbc:postgresql://<neon-host>/<db>?sslmode=require
# DB_USERNAME=<neon-user>
# DB_PASSWORD=<neon-password>
# JWT_SECRET=<separate production secret, never reused from local>
